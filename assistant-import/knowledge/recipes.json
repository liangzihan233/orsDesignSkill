      }
    },
    {
      "id": "css-root",
      "title": "设置本题根节点文字颜色",
      "placement": "基本属性 → 自定义 CSS → 当前设备",
      "notes": "question_demo 是演示内部 ID；替换为实际根节点 question_<内部ID>，不是题目编码。平台不会自动替换 {id}，CSS 不自动限制在本题，避免宽泛选择器。这里只做语法检查，必须另外观察效果。",
      "request": {
        "kind": "css",
        "source": "#question_demo { color: #2563eb; }"
      }
    }
  ]
}