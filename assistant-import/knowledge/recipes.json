{
  "platformVersion": "1.177.0",
  "recipes": [
    {
      "id": "display-any",
      "title": "多选任意命中才显示本题",
      "placement": "目标题目 → 题目逻辑 → 显示逻辑 → 本题显示代码（表达式）",
      "notes": "Q1 是来源题真实编码，A1/A2 是其选项编码。未答返回 false。",
      "request": {
        "kind": "questionVisibility",
        "mode": "expression",
        "source": "Q1.isSelected(\"A1\") || Q1.isSelected(\"A2\")",
        "cases": [
          {
            "label": "选中 A1",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "label": "选中 A2",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A2"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "label": "只选 A3",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A3"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "label": "未作答",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [],
                "HAS_ANSWER": false
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "option-display",
      "title": "选项显示条件",
      "placement": "目标题目 → 编号和显示代码 → 目标选项行的显示代码",
      "notes": "仅控制当前子项。不要把它放到题目渲染逻辑。",
      "request": {
        "kind": "optionVisibility",
        "mode": "expression",
        "source": "Q1.isSelected(\"A1\")",
        "cases": [
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [],
                "HAS_ANSWER": false
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "display-function",
      "title": "自定义布尔显示函数",
      "placement": "本题显示代码右侧的自定义代码 → 函数模式",
      "notes": "复杂条件用 questionVisibility；选项或矩阵轴使用 optionVisibility。必须返回 true/false。",
      "request": {
        "kind": "questionVisibility",
        "mode": "function",
        "source": "function questionVisibility(context) { return Q1.isSelected(\"A1\") || Q1.isSelected(\"A2\"); }",
        "cases": [
          {
            "label": "选中 A1",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "label": "选中 A2",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A2"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "label": "只选 A3",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A3"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "label": "未作答",
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [],
                "HAS_ANSWER": false
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "not-answered",
      "title": "区分未选中与尚未回答",
      "placement": "本题显示代码（表达式）",
      "notes": "!isSelected 包含未答；需要答过但没选 A1 时加 hasAnswer。",
      "request": {
        "kind": "questionVisibility",
        "mode": "expression",
        "source": "Q1.hasAnswer && !Q1.isSelected(\"A1\")",
        "cases": [
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [],
                "HAS_ANSWER": false
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A3"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "selection-sets",
      "title": "全部包含、任意命中、完全不含",
      "placement": "公式与变量 → 表达式",
      "notes": "数组链式 isin 表示所选值全部属于给定集合，不表示给定集合全部被选。全部包含 A1/A2 用两个 isSelected 和 &&。",
      "request": {
        "kind": "compute",
        "mode": "expression",
        "source": "[Q1.isSelected(\"A1\") && Q1.isSelected(\"A2\"), Q1.select().any(\"A1\", \"A2\"), Q1.select().notin(\"A1\", \"A2\"), Q1.select().isin(\"A1\", \"A2\")]",
        "cases": [
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": [
                false,
                true,
                false,
                true
              ]
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1",
                  "A2",
                  "A3"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": [
                true,
                true,
                false,
                false
              ]
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [],
                "HAS_ANSWER": false
              }
            },
            "expected": {
              "ok": true,
              "value": [
                false,
                false,
                true,
                false
              ]
            }
          }
        ]
      }
    },
    {
      "id": "prefill-text",
      "title": "首次预填文本并保留前导零",
      "placement": "基本属性 → 答案预填代码",
      "notes": "用于本题为普通单值文本的情形。只在真实初始化条件满足时执行；不覆盖恢复或人工回答。",
      "request": {
        "kind": "initializeAnswer",
        "mode": "function",
        "source": "function initializeAnswer(context) { return { mode: \"show\", answer: \"001\" }; }",
        "cases": [
          {
            "expected": {
              "ok": true,
              "value": {
                "mode": "show",
                "answer": "001"
              }
            }
          }
        ]
      }
    },
    {
      "id": "render-title",
      "title": "根据前题修改本题展示标题",
      "placement": "基本属性 → 题目渲染逻辑",
      "notes": "只覆盖展示，不改变保存题干、导出或答案，不允许 end/goto/网络。",
      "request": {
        "kind": "beforeShow",
        "mode": "function",
        "source": "function beforeShow(context) { if (Q1.isSelected(\"A1\")) return { view: { title: \"您选择了 A1，请说明原因\" } }; return { view: {} }; }",
        "cases": [
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": {
                "view": {
                  "title": "您选择了 A1，请说明原因"
                }
              }
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [],
                "HAS_ANSWER": false
              }
            },
            "expected": {
              "ok": true,
              "value": {
                "view": {}
              }
            }
          }
        ]
      }
    },
    {
      "id": "validate-number",
      "title": "数字零有效、空白不允许",
      "placement": "Q2 基本属性 → 答案校验逻辑",
      "notes": "仅用于答案为单个字符串或数字的填空题；矩阵或多项填空不能套用。系统必答/格式检查在代码之前。",
      "request": {
        "kind": "validateAnswer",
        "mode": "function",
        "source": "function validateAnswer(context) { const x = context.answer; const missing = x === null || x === undefined || (typeof x === \"string\" && !x.trim()); const valid = !missing && (typeof x === \"number\" || typeof x === \"string\") && Number.isFinite(Number(x)); if (!valid) context.setError(\"请输入有效数字，0 可以填写\"); return valid; }",
        "cases": [
          {
            "context": {
              "answer": 0
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "context": {
              "answer": "0"
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "context": {
              "answer": ""
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "context": {
              "answer": "  "
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "context": {
              "answer": null
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "context": {
              "answer": "abc"
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "context": {
              "answer": false
            },
            "expected": {
              "ok": true,
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "validate-score",
      "title": "评分在指定范围内",
      "placement": "评分题基本属性 → 答案校验逻辑",
      "notes": "先使用题型自带范围；确需附加业务限制时使用代码。示例答案为数字，范围 1 到 5。",
      "request": {
        "kind": "validateAnswer",
        "mode": "function",
        "source": "function validateAnswer(context) { const v=context.answer; const valid=typeof v === \"number\" && Number.isFinite(v) && v >= 1 && v <= 5; if (!valid) context.setError(\"请给出 1 到 5 分\"); return valid; }",
        "cases": [
          {
            "context": {
              "answer": 1
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "context": {
              "answer": 5
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "context": {
              "answer": 0
            },
            "expected": {
              "ok": true,
              "value": false
            }
          },
          {
            "context": {
              "answer": null
            },
            "expected": {
              "ok": true,
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "matrix-jump",
      "title": "矩阵行选择某列后跳题",
      "placement": "Q3 基本属性 → 跳转逻辑 → 代码块",
      "notes": "仅用于矩阵选择题。R1/C2 必须是真实行列编码；默认编码可能是 S1/A2，不能用显示序号代替。行判断读取列编码；列判断读取行编码。",
      "request": {
        "kind": "resolveNext",
        "mode": "function",
        "source": "if (Q3.$row.R1.isSelected(\"C2\")) { goto(\"Q5\"); }",
        "cases": [
          {
            "questions": {
              "Q3": {
                "id": "q3",
                "code": "Q3",
                "type": "MATRIX_RADIO",
                "SELECT": [],
                "MATRIX_REFS": {
                  "rows": [
                    {
                      "id": "r1",
                      "code": "R1",
                      "cells": [
                        {
                          "columnId": "c2",
                          "isSelected": true
                        }
                      ]
                    }
                  ],
                  "columns": [
                    {
                      "id": "c2",
                      "code": "C2"
                    }
                  ]
                }
              },
              "Q5": {
                "id": "q5",
                "code": "Q5",
                "type": "FILLBLANK",
                "SELECT": []
              }
            },
            "expected": {
              "ok": true,
              "value": {
                "directive": {
                  "type": "goto",
                  "questionId": "q5"
                }
              }
            }
          },
          {
            "questions": {
              "Q3": {
                "id": "q3",
                "code": "Q3",
                "type": "MATRIX_RADIO",
                "SELECT": [],
                "MATRIX_REFS": {
                  "rows": [
                    {
                      "id": "r1",
                      "code": "R1",
                      "cells": [
                        {
                          "columnId": "c2",
                          "isSelected": false
                        }
                      ]
                    }
                  ],
                  "columns": [
                    {
                      "id": "c2",
                      "code": "C2"
                    }
                  ]
                }
              },
              "Q5": {
                "id": "q5",
                "code": "Q5",
                "type": "FILLBLANK",
                "SELECT": []
              }
            },
            "expected": {
              "ok": true,
              "value": {
                "directive": {
                  "type": "default"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "screen-out",
      "title": "未选 A1 时筛选结束",
      "placement": "Q1 跳转逻辑 → 代码块",
      "notes": "Q1 确认答案并校验后执行；不会在渲染阶段执行。end 为筛选结束，不等同正常完成。",
      "request": {
        "kind": "resolveNext",
        "mode": "function",
        "source": "if (!Q1.isSelected(\"A1\")) { end(); }",
        "cases": [
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A3"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": {
                "directive": {
                  "type": "finish",
                  "reason": "SCREENED_OUT"
                }
              }
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": {
                "directive": {
                  "type": "default"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "auto-select",
      "title": "根据前题自动勾选当前选项",
      "placement": "目标选项 → 自动选择选项 → 表达式",
      "notes": "返回布尔值，true 仅代表此规则命中。与默认选项、预填和直接通过分别配置；只引用允许读取的前序题。",
      "request": {
        "kind": "shouldSelect",
        "mode": "expression",
        "source": "Q1.isSelected(\"A1\")",
        "cases": [
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [
                  "A1"
                ],
                "HAS_ANSWER": true
              }
            },
            "expected": {
              "ok": true,
              "value": true
            }
          },
          {
            "questions": {
              "Q1": {
                "id": "q1",
                "code": "Q1",
                "type": "CHECKBOX",
                "SELECT": [],
                "HAS_ANSWER": false
              }
            },
            "expected": {
              "ok": true,
              "value": false
            }
          }
        ]
      }
    },
    {
      "id": "formula",
      "title": "普通公式读取数值",
      "placement": "公式与变量 → 表达式",
      "notes": "示例 Q2 是数值答案的题目快照。实际问卷中的前序依赖及题型维度须核对。",
      "request": {
        "kind": "compute",
        "mode": "expression",
        "source": "SUM([Q2.value, 5])",
